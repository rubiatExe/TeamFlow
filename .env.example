# Next.js / Vercel
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DEMO_MERCHANT_ID=00000000-0000-0000-0000-000000000001

# Gemini
GOOGLE_API_KEY=
SCORER_MODEL=gemini-3.1-pro-preview
SCORER_FALLBACK_MODEL=gemini-3.1-pro-preview
SCORER_MAX_ATTEMPTS=2
SCORER_MAX_OUTPUT_TOKENS=2048

# Cloud Run document processor
OCR_SERVICE_URL=http://localhost:8000
OCR_SERVICE_TOKEN=

# Optional MCP scoring agent
MCP_SERVER_URL=http://localhost:8001/mcp

# Candidate invitations
JWT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Document processor and local MCP runtime
MOCK_MODE=True
ENVIRONMENT=development
DOCUMENT_PROCESSOR_OTEL_SERVICE_NAME=teamflow-document-processor
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Distributed tracing (disabled until a local OTLP collector is running)
TEAMFLOW_OTEL_ENABLED=false
NEXT_OTEL_SERVICE_NAME=teamflow-next-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
GOOGLE_CLOUD_PROJECT=
