# Next.js / Vercel
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local legacy-demo/server-administration only. Never mount in the hiring-agent runtime.
SUPABASE_SERVICE_ROLE_KEY=
DEMO_MERCHANT_ID=00000000-0000-0000-0000-000000000001
# Local demos only. Production ignores this flag and keeps unauthenticated legacy
# candidate, invite, parser, application, and simulated Square routes closed.
TEAMFLOW_ENABLE_LEGACY_DEMO_ROUTES=false

# Gemini
GOOGLE_API_KEY=
SCORER_MODEL=gemini-3.1-pro-preview
SCORER_FALLBACK_MODEL=gemini-3.1-pro-preview
SCORER_MAX_ATTEMPTS=2
SCORER_MAX_OUTPUT_TOKENS=2048

# Cloud Run document processor
OCR_SERVICE_URL=http://localhost:8000
# Required in production and must exactly match the scheme/host/port above.
OCR_SERVICE_TRUSTED_ORIGIN=http://localhost:8000
# Production: independent CSPRNG token with >=256 bits of entropy; 32-512 printable
# ASCII characters with no whitespace. Format validation does not attest entropy.
OCR_SERVICE_TOKEN=
OCR_TIMEOUT_SECONDS=25
EMBEDDING_TIMEOUT_SECONDS=10

# LangGraph hiring workflow
# The Next.js route is private and disabled until both values are configured.
HIRING_AGENT_ENABLED=false
HIRING_AGENT_ROUTE_TOKEN=
HIRING_AGENT_URL=http://localhost:8080
# Required in production and must exactly match the scheme/host/port above.
HIRING_AGENT_TRUSTED_ORIGIN=http://localhost:8080
# Production: independent CSPRNG token with >=256 bits of entropy; 32-512 printable
# ASCII characters with no whitespace. Format validation does not attest entropy.
HIRING_AGENT_TOKEN=
HIRING_AGENT_MODEL=gemini-3.7-flash
HIRING_AGENT_FALLBACK_MODEL=gemini-3.6-flash
HIRING_AGENT_MAX_TOOL_ROUNDS=2
HIRING_AGENT_MAX_TOOL_CALLS_PER_ROUND=3
HIRING_AGENT_MODEL_TIMEOUT_SECONDS=12
HIRING_AGENT_TIMEOUT_SECONDS=45
HIRING_AGENT_MAX_CONCURRENCY=4
HIRING_AGENT_QUEUE_TIMEOUT_SECONDS=1
HIRING_AGENT_MAX_REQUEST_BYTES=65536
HIRING_AGENT_MOCK_TOOLS=false
# Optional Phase 4 result persistence only; MCP candidate-score mutation is retired.
AGENT_ALLOW_WRITES=false
RESUME_REVIEW_STORE_DOCUMENTS=false
RESUME_REVIEW_PERSIST_RESULTS=false

# Durable résumé-review HITL (server only; disabled until DB roles are provisioned)
TEAMFLOW_HITL_ENABLED=false
SUPABASE_ANON_KEY=
# Use a direct/session PostgreSQL endpoint, the exact dedicated login, and SSL.
TEAMFLOW_HITL_DSN=postgresql://teamflow_hitl_service:password@db.example:5432/postgres?sslmode=verify-full
# Independent canonical base64url secret encoding 32-64 random bytes. Bind a numeric
# Secret Manager version and provision the decoded bytes in the private keyring.
TEAMFLOW_HITL_CAPABILITY_SECRET=
TEAMFLOW_HITL_DB_MIN_POOL_SIZE=1
TEAMFLOW_HITL_DB_MAX_POOL_SIZE=4
# Runtime is read/write only within the pre-migrated private checkpoint schema.
TEAMFLOW_CHECKPOINT_DSN=postgresql://teamflow_checkpoint_runtime:password@db.example:5432/postgres?sslmode=verify-full
TEAMFLOW_CHECKPOINT_MIN_POOL_SIZE=1
TEAMFLOW_CHECKPOINT_MAX_POOL_SIZE=2
TEAMFLOW_HITL_AUTH_TIMEOUT_SECONDS=5
TEAMFLOW_HITL_MAX_CONCURRENCY=4
TEAMFLOW_HITL_QUEUE_TIMEOUT_SECONDS=1
# Queue + start remain below the Next.js 50s and Cloud Run 60s boundaries.
TEAMFLOW_HITL_START_TIMEOUT_SECONDS=45
TEAMFLOW_HITL_DECISION_TIMEOUT_SECONDS=15
TEAMFLOW_HITL_INSPECT_TIMEOUT_SECONDS=5
TEAMFLOW_HITL_MAX_DECISION_REQUEST_BYTES=524288
# Administration only; never bind this migrator DSN to the Cloud Run service.
TEAMFLOW_CHECKPOINT_MIGRATION_DSN=postgresql://teamflow_checkpoint_migrator:password@db.example:5432/postgres?sslmode=verify-full
TEAMFLOW_CHECKPOINT_MIGRATE=

# Candidate invitations
JWT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Document processor and local MCP runtime
MOCK_MODE=False
ENVIRONMENT=development
DOCUMENT_PROCESSOR_OTEL_SERVICE_NAME=teamflow-document-processor
SUPABASE_URL=
# Required by the hiring agent in production; origin must exactly match SUPABASE_URL.
SUPABASE_TRUSTED_ORIGIN=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_HIRING_READER_TOKEN=

# Distributed tracing (disabled until a local OTLP collector is running)
TEAMFLOW_OTEL_ENABLED=false
NEXT_OTEL_SERVICE_NAME=teamflow-next-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_PROPAGATORS=tracecontext
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
GOOGLE_CLOUD_PROJECT=
