{
  "name": "teamflow",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/unit/*.test.ts",
    "test:journeys": "npm run test:journeys:development",
    "test:journeys:development": "node scripts/run-critical-journey-smoke.mjs --mode=development",
    "test:journeys:production": "node scripts/run-critical-journey-smoke.mjs --mode=production",
    "verify:contracts": "node scripts/verify-integration-contracts.mjs && npm run verify:model-contract && npm run verify:release-hardening",
    "verify:model-contract": "node scripts/verify-model-contract.mjs",
    "verify:release-hardening": "node scripts/verify-release-hardening.mjs",
    "verify:quick": "node scripts/verify-workspace.mjs quick",
    "verify:all": "node scripts/verify-workspace.mjs all"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@opentelemetry/api": "^1.9.1",
    "@supabase/supabase-js": "^2.94.1",
    "@vercel/otel": "^2.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.563.0",
    "next": "16.3.3",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7"
  }
}
